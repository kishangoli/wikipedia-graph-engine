# These are examples, not automatically loaded. Export them in your shell.
WIKI_CACHE_TTL_SECONDS=86400
WIKI_MAX_SEARCH_SECONDS=60
WIKI_MAX_UNCACHED_EXPANSIONS=200
WIKI_MAX_DISCOVERED_ARTICLES=20000
WIKI_MAX_DEPTH=4
WIKI_MAX_CONCURRENT_REQUESTS=2
WIKI_REQUEST_INTERVAL_SECONDS=0.5
# Before shared/public use, set a real contact URL or email in the User-Agent.
# WIKI_USER_AGENT="WikipediaPathFinder/0.1 (your contact URL or email)"
